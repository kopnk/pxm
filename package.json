{
  "name": "pxm",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/checks/build-prod.mjs",
    "build:api:lambda": "node scripts/checks/build-aws-lambda.mjs",
    "dev": "node scripts/dev/dev-stage-dev.mjs",
    "dev:stage:dev": "node scripts/dev/dev-stage-dev.mjs",
    "dev:stage:dev:ui": "node scripts/dev/dev-stage-dev-ui.mjs",
    "dev:stage:dev:api": "node scripts/dev/local-api-proxy.mjs",
    "generate": "nuxt generate",
    "lint": "node scripts/checks/lint-production-guards.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "npm run test:routes && npm run test:rls",
    "test:routes": "node scripts/checks/smoke-critical-routes.mjs",
    "test:rls": "node scripts/checks/smoke-rls-crud.mjs",
    "typecheck": "nuxt typecheck",
    "cdk:synth:dev": "npm run build:api:lambda && node scripts/checks/cdk-synth-stage.mjs dev",
    "cdk:synth:prod": "npm run build:api:lambda && node scripts/checks/cdk-synth-stage.mjs prod",
    "cdk:deploy:dev": "npm run build:api:lambda && cdk deploy -c stage=dev --output .cdk.out-verify/dev --outputs-file .cdk-outputs/dev.json",
    "cdk:deploy:prod": "npm run build:api:lambda && cdk deploy -c stage=prod --output .cdk.out-verify/prod --outputs-file .cdk-outputs/prod.json",
    "cdk:outputs:dev": "node scripts/dev/read-cdk-output.mjs dev",
    "cdk:outputs:prod": "node scripts/dev/read-cdk-output.mjs prod",
    "cdk:api:dev": "node scripts/dev/read-cdk-output.mjs dev ApiUrl",
    "cdk:api:prod": "node scripts/dev/read-cdk-output.mjs prod ApiUrl"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1075.0",
    "@aws-sdk/client-dynamodb": "^3.1075.0",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/lib-dynamodb": "^3.1075.0",
    "@pinia/nuxt": "^0.11.3",
    "aws-cdk-lib": "^2.260.0",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "constructs": "^10.6.0",
    "dotenv": "^16.4.7",
    "nuxt": "^4.3.0",
    "pdfkit": "^0.18.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "vue": "^3.5.27",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.6.4",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/pdfkit": "^0.17.5",
    "@types/qrcode": "^1.5.6",
    "aws-cdk": "^2.1128.1",
    "sass-embedded": "^1.97.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.5"
  }
}
