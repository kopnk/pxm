# PostgreSQL connection string used by Nitro server and Drizzle.
DATABASE_URL=postgres://user:password@localhost:5432/pxm

# Supabase Storage. Use service role only on the server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Set true on production HTTPS so Lucia cookies are Secure.
SESSION_COOKIE_SECURE=true

# Optional HMAC secret for signed Partner PO PDF QR links.
# Leave empty to require logged-in session for the PDF route.
PARTNER_PO_PDF_SECRET=replace-with-long-random-secret

# Keep disabled in production unless actively debugging.
NUXT_DEVTOOLS=false
