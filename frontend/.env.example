# PXM environment template
# Copy only one stage block into .env, then fill secret values locally.
# Do not commit .env, real secret values, or real resource ids.
# Fill the <placeholders> from `npm run cdk:outputs:dev` / `cdk:outputs:prod`.

# ---------------------------------------------------------------------------
# DEV: localhost UI http://localhost:3000 + API proxy http://localhost:3001
# ---------------------------------------------------------------------------
PXM_STAGE=dev
AWS_PROFILE=default
AWS_REGION=ap-southeast-1
AWS_DEFAULT_REGION=ap-southeast-1

SESSION_COOKIE_SECURE=false
NUXT_PUBLIC_API_BASE_URL=http://localhost:3001
PXM_DEV_API_URL=https://<api-id>.execute-api.ap-southeast-1.amazonaws.com/dev/
NUXT_DEVTOOLS=false

AWS_DYNAMODB_TABLE=pxm-dev
TABLE_NAME=pxm-dev
AWS_COGNITO_USER_POOL_ID=<dev-user-pool-id>
AWS_COGNITO_CLIENT_ID=<dev-app-client-id>
COGNITO_USER_POOL_ID=<dev-user-pool-id>
COGNITO_USER_POOL_CLIENT_ID=<dev-app-client-id>
AWS_APP_FILES_BUCKET=<dev-files-bucket>
APP_FILES_BUCKET=<dev-files-bucket>
AWS_APP_FILES_CLOUDFRONT_DOMAIN=https://<dev-files-distribution>.cloudfront.net
APP_FILES_CLOUDFRONT_DOMAIN=https://<dev-files-distribution>.cloudfront.net

# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
AWS_AUTH_COOKIE_SECRET=
AWS_SES_FROM_EMAIL=
PARTNER_PO_PDF_SECRET=

PXM_LOCAL_UI_HOST=localhost
PXM_LOCAL_UI_PORT=3000
PXM_LOCAL_API_PROXY_HOST=localhost
PXM_LOCAL_API_PROXY_PORT=3001
PXM_LOCAL_UI_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# PROD: CloudFront https://www.proxem.site + API Gateway /prod
# Use this block for production build/generate/deploy context only.
# Lambda runtime env is managed by CDK, so do not put production secrets in git.
# ---------------------------------------------------------------------------
# PXM_STAGE=prod
# AWS_PROFILE=default
# AWS_REGION=ap-southeast-1
# AWS_DEFAULT_REGION=ap-southeast-1
#
# SESSION_COOKIE_SECURE=true
# NUXT_PUBLIC_API_BASE_URL=/
# NUXT_DEVTOOLS=false
#
# AWS_DYNAMODB_TABLE=pxm-prod
# TABLE_NAME=pxm-prod
# AWS_COGNITO_USER_POOL_ID=<prod-user-pool-id>
# AWS_COGNITO_CLIENT_ID=<prod-app-client-id>
# COGNITO_USER_POOL_ID=<prod-user-pool-id>
# COGNITO_USER_POOL_CLIENT_ID=<prod-app-client-id>
# AWS_APP_FILES_BUCKET=<prod-files-bucket>
# APP_FILES_BUCKET=<prod-files-bucket>
# AWS_APP_FILES_CLOUDFRONT_DOMAIN=https://<prod-files-distribution>.cloudfront.net
# APP_FILES_CLOUDFRONT_DOMAIN=https://<prod-files-distribution>.cloudfront.net
#
# AWS_AUTH_COOKIE_SECRET=
# AWS_SES_FROM_EMAIL=
# PARTNER_PO_PDF_SECRET=
