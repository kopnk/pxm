# PXM environment template
# Copy only one stage block into .env, then fill secret values locally.
# Do not commit .env or real secret values.

# ---------------------------------------------------------------------------
# DEV: localhost UI http://localhost:3000 + API proxy http://localhost:3001
# ---------------------------------------------------------------------------
PXM_STAGE=dev
AWS_PROFILE=default
AWS_REGION=ap-southeast-1
AWS_DEFAULT_REGION=ap-southeast-1

SESSION_COOKIE_SECURE=false
NUXT_PUBLIC_API_BASE_URL=http://localhost:3001
NUXT_DEVTOOLS=false

AWS_DYNAMODB_TABLE=pxm-dev
TABLE_NAME=pxm-dev
AWS_COGNITO_USER_POOL_ID=ap-southeast-1_Wfau3KXgN
AWS_COGNITO_CLIENT_ID=64kil8u26m2gpiaghu969jsio9
COGNITO_USER_POOL_ID=ap-southeast-1_Wfau3KXgN
COGNITO_USER_POOL_CLIENT_ID=64kil8u26m2gpiaghu969jsio9
AWS_APP_FILES_BUCKET=pxm-dev-files-905418212759-ap-southeast-1
APP_FILES_BUCKET=pxm-dev-files-905418212759-ap-southeast-1
AWS_APP_FILES_CLOUDFRONT_DOMAIN=https://d1ey5u99ghztat.cloudfront.net
APP_FILES_CLOUDFRONT_DOMAIN=https://d1ey5u99ghztat.cloudfront.net

AWS_AUTH_COOKIE_SECRET=replace-with-long-random-dev-secret
AWS_DEFAULT_USER_PASSWORD=replace-with-temporary-dev-password
AWS_SES_FROM_EMAIL=
PARTNER_PO_PDF_SECRET=

PXM_LOCAL_UI_HOST=localhost
PXM_LOCAL_UI_PORT=3000
PXM_LOCAL_API_PROXY_HOST=localhost
PXM_LOCAL_API_PROXY_PORT=3001
PXM_LOCAL_UI_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# PROD: CloudFront https://www.proxem.site + API Gateway /prod
# Use this block for production build/generate/deploy context only.
# Lambda runtime env is managed by CDK, so do not put production secrets in git.
# ---------------------------------------------------------------------------
# PXM_STAGE=prod
# AWS_PROFILE=default
# AWS_REGION=ap-southeast-1
# AWS_DEFAULT_REGION=ap-southeast-1
#
# SESSION_COOKIE_SECURE=true
# NUXT_PUBLIC_API_BASE_URL=/
# NUXT_DEVTOOLS=false
