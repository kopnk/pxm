{
  "name": "@pxm/frontend",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/checks/build-nuxt.mjs prod",
    "build:api:lambda": "node scripts/checks/build-nuxt.mjs lambda",
    "dev": "node scripts/dev/dev-stage-dev.mjs",
    "dev:stage:dev": "node scripts/dev/dev-stage-dev.mjs",
    "dev:stage:dev:ui": "node scripts/dev/dev-stage-dev-ui.mjs",
    "dev:stage:dev:api": "node scripts/dev/local-api-proxy.mjs",
    "generate": "node scripts/checks/generate-frontend.mjs",
    "lint": "node scripts/checks/lint-production-guards.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "npm run test:routes && npm run test:rls",
    "test:routes": "node scripts/checks/smoke-critical-routes.mjs",
    "test:rls": "node scripts/checks/smoke-rls-crud.mjs",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1075.0",
    "@aws-sdk/client-dynamodb": "^3.1075.0",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/client-secrets-manager": "^3.1096.0",
    "@aws-sdk/lib-dynamodb": "^3.1075.0",
    "@pinia/nuxt": "^0.11.3",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "dotenv": "^16.4.7",
    "nuxt": "4.3.0",
    "pdfjs-dist": "^6.2.108",
    "pdfkit": "^0.18.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "vue": "^3.5.27",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.6.4",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/pdfkit": "^0.17.5",
    "@types/qrcode": "^1.5.6",
    "sass-embedded": "1.97.3",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.5"
  }
}
